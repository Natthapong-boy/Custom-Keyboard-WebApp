# Server Port
PORT=5000

# ==========================================
# MongoDB Atlas Database Configuration
# ==========================================
# วิธีที่ 1: แยกใส่เฉพาะ User & Password ของตัวเอง (แนะนำสำหรับทำงานร่วมกับเพื่อน)
DB_USER=your_username_here
DB_PASSWORD=your_password_here
DB_CLUSTER=cluster0.s9tq6pl.mongodb.net
DB_NAME=KeyCraft

# วิธีที่ 2: หรือใส่เป็น Full URI ก้อนเดียว
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.s9tq6pl.mongodb.net/KeyCraft?appName=Cluster0

# JWT Authentication Secret
JWT_SECRET=super_secret_key_craft_jwt_token_2026_dev

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# PromptPay Mobile Phone or National ID / Tax ID for Dynamic QR Payment
PROMPTPAY_ACCOUNT_ID=0812345678
